{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateCommit", "baseCommit", "researchDecision", "semanticGateSummary", "performanceSummary", "environment", "integrationEvidence", "operationalEvidence", "untrustedCandidateDiff"],
  "properties": {
    "candidateCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}([A-Fa-f0-9]{24})?$" },
    "baseCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}([A-Fa-f0-9]{24})?$" },
    "researchDecision": { "enum": ["keep", "reject"] },
    "semanticGateSummary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "evidenceSource", "evidenceSha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "passed": { "const": true },
          "evidenceSource": { "type": "string", "minLength": 1 },
          "evidenceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "performanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "score", "confidenceIntervalLow", "confidenceIntervalHigh", "worstScenarioRegressionPercent", "pairedTrialCount"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "direction": { "const": "maximize" },
        "score": { "type": "number" },
        "confidenceIntervalLow": { "type": "number" },
        "confidenceIntervalHigh": { "type": "number" },
        "worstScenarioRegressionPercent": { "type": "number", "minimum": 0 },
        "pairedTrialCount": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "runtime", "dependencyPins"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 16 },
        "runtime": { "type": "string", "minLength": 1 },
        "dependencyPins": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "integrationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "summary"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "operationalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "summary"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "untrustedCandidateDiff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evaluation-Authority-produced sanitized diff. The schema validates declarations; the external builder must enforce them.",
      "required": ["encoding", "content", "sourceSha256", "candidateControlledTextRemoved", "commentsRemoved", "stringLiteralsRedacted"],
      "properties": {
        "encoding": { "const": "json-escaped-untrusted-text" },
        "content": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "candidateControlledTextRemoved": { "const": true },
        "commentsRemoved": { "const": true },
        "stringLiteralsRedacted": { "const": true }
      }
    }
  }
}
